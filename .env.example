# Copiar a .env solo para desarrollo local. NUNCA subir .env al repositorio.
# En Railway estas variables se definen en el panel de cada servicio.

# Railway la inyecta al referenciar el servicio Postgres: ${{Postgres.DATABASE_URL}}
# Local (SQLite de prueba): sqlite:///./dev.db
DATABASE_URL=sqlite:///./dev.db

# Solo servicio MCP: token que Claude debe enviar. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=

# Solo servicio landing: número de WhatsApp de prueba (8 dígitos, sin +506)
WHATSAPP_NEGOCIO=
